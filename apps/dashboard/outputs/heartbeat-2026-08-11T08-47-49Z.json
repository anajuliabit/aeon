{
  "root": "card_heartbeat",
  "state": {},
  "elements": {
    "card_heartbeat": {
      "type": "Card",
      "props": {
        "title": "heartbeat"
      },
      "children": [
        "stack_content"
      ]
    },
    "stack_content": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "alert_degraded",
        "sep1",
        "timestamp",
        "sep2",
        "event_section",
        "sep3",
        "pattern_section",
        "sep4",
        "issue_section",
        "sep5",
        "metrics_section",
        "sep6",
        "escalation_section",
        "sep7",
        "recovery_section",
        "sep8",
        "status_section"
      ]
    },
    "alert_degraded": {
      "type": "Alert",
      "props": {
        "type": "error",
        "title": "System Degraded",
        "message": "🔴 Status page updated to degraded"
      }
    },
    "sep1": {
      "type": "Separator"
    },
    "timestamp": {
      "type": "Heading",
      "props": {
        "text": "08:41Z",
        "level": "h3"
      }
    },
    "sep2": {
      "type": "Separator"
    },
    "event_section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "event_heading",
        "event_text"
      ]
    },
    "event_heading": {
      "type": "Heading",
      "props": {
        "text": "Primary Event",
        "level": "h4"
      }
    },
    "event_text": {
      "type": "Text",
      "props": {
        "text": "cost-report fresh sdk_opt_in_required fail at 08:19Z"
      }
    },
    "sep3": {
      "type": "Separator"
    },
    "pattern_section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "pattern_heading",
        "pattern_text"
      ]
    },
    "pattern_heading": {
      "type": "Heading",
      "props": {
        "text": "Pattern Detection",
        "level": "h4"
      }
    },
    "pattern_text": {
      "type": "Text",
      "props": {
        "text": "2nd same-signature print in 12h (post 8-10 20:32Z)"
      }
    },
    "sep4": {
      "type": "Separator"
    },
    "issue_section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "issue_heading",
        "issue_details",
        "issue_status"
      ]
    },
    "issue_heading": {
      "type": "Heading",
      "props": {
        "text": "Issue ISS-030",
        "level": "h4"
      }
    },
    "issue_details": {
      "type": "Text",
      "props": {
        "text": "4-consecutive-week trigger extends to n=2 intra-day datapoints, still week-1 shape"
      }
    },
    "issue_status": {
      "type": "Badge",
      "props": {
        "text": "Active",
        "variant": "destructive"
      }
    },
    "sep5": {
      "type": "Separator"
    },
    "metrics_section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "metrics_heading",
        "metrics_row"
      ]
