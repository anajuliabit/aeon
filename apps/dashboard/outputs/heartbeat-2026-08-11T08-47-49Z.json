      "type": "Text",
      "props": {
        "text": "fork-cohort 48h escalation expected ~19:05Z tonight"
      }
    },
    "sep7": {
      "type": "Separator"
    },
    "recovery_section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "recovery_heading",
        "recovery_plan",
        "dispatch_label",
        "dispatch_list"
      ]
    },
    "recovery_heading": {
      "type": "Heading",
      "props": {
        "text": "Recovery",
        "level": "h4"
      }
    },
    "recovery_plan": {
      "type": "Text",
      "props": {
        "text": "6-skill stuck cohort self-clears on next dispatch"
      }
    },
    "dispatch_label": {
      "type": "Text",
      "props": {
        "text": "Expected dispatch times:",
        "variant": "lead"
      }
    },
    "dispatch_list": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "dispatch_1",
        "dispatch_2",
        "dispatch_3"
      ]
    },
    "dispatch_1": {
      "type": "Text",
      "props": {
        "text": "• github-trending 09Z"
      }
    },
    "dispatch_2": {
      "type": "Text",
      "props": {
        "text": "• unlock-monitor 10Z"
      }
    },
    "dispatch_3": {
      "type": "Text",
      "props": {
        "text": "• token-alert 12Z"
      }
    },
    "sep8": {
      "type": "Separator"
    },
    "status_section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "status_heading",
        "status_text"
      ]
    },
    "status_heading": {
      "type": "Heading",
      "props": {
        "text": "Status Page Update",
        "level": "h4"
      }
    },
    "status_text": {
      "type": "Text",
      "props": {
        "text": "Status page rewrote to 🔴 degraded"
      }
    }
