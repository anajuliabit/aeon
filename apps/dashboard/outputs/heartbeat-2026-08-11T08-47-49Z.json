    "metrics_heading": {
      "type": "Heading",
      "props": {
        "text": "Metrics",
        "level": "h4"
      }
    },
    "metrics_row": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "lg"
      },
      "children": [
        "stat_consec",
        "stat_sr"
      ]
    },
    "stat_consec": {
      "type": "Stat",
      "props": {
        "label": "Consecutive Failures",
        "value": "28"
      }
    },
    "stat_sr": {
      "type": "Stat",
      "props": {
        "label": "Success Rate",
        "value": "8%",
        "trend": "down"
      }
    },
    "sep6": {
      "type": "Separator"
    },
    "escalation_section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
