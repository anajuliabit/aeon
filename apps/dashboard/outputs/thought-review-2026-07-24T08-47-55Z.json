{
  "root": "card_main",
  "state": {},
  "elements": {
    "card_main": {
      "type": "Card",
      "props": {
        "title": "🧭 thought review"
      },
      "children": [
        "stack_main"
      ]
    },
    "stack_main": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "stack_metrics",
        "text_status",
        "separator_1",
        "alert_priorities"
      ]
    },
    "stack_metrics": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "lg"
      },
      "children": [
        "text_timeframe",
        "stat_captures"
      ]
    },
    "text_timeframe": {
      "type": "Text",
      "props": {
        "text": "last 24h"
      }
    },
    "stat_captures": {
      "type": "Stat",
      "props": {
        "label": "captures",
        "value": "0"
      }
    },
    "text_status": {
      "type": "Text",
      "props": {
        "text": "nothing to surface",
        "variant": "muted"
      }
    },
    "separator_1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "alert_priorities": {
      "type": "Alert",
      "props": {
        "message": "priorities.md last reviewed 50d ago — worth a refresh",
        "type": "info"
      }
    }
  }
}
