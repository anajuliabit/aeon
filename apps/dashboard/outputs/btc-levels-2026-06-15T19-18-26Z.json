      }
    },
    "text-review-trigger": {
      "type": "Text",
      "props": {
        "text": "Leveraged cbBTC position review trigger: ≤$45k",
        "variant": "body"
      }
    },
    "separator-2": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "alert-disclaimer": {
      "type": "Alert",
      "props": {
        "message": "Not financial advice",
        "type": "info"
      }
    }
