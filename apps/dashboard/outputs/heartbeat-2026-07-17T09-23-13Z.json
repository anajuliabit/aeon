{
  "root": "heartbeat-card",
  "state": {},
  "elements": {
    "heartbeat-card": {
      "type": "Card",
      "props": {
        "title": "Heartbeat",
        "description": "System status report"
      },
      "children": [
        "main-alert",
        "sep1",
        "affected-skills-stack",
        "sep2",
        "issues-stack",
        "sep3",
        "prs-stack"
      ]
    },
    "main-alert": {
      "type": "Alert",
      "props": {
        "type": "error",
        "title": "🔴 07:00Z morning batch missed 2nd consecutive day",
        "message": "Critical scheduling failure"
      }
    },
    "sep1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "affected-skills-stack": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
