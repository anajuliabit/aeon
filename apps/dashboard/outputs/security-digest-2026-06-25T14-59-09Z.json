{
  "root": "card",
  "state": {},
  "elements": {
    "card": {
      "type": "Card",
      "props": {
        "title": "Security Digest"
      },
      "children": [
        "date",
        "verdict",
        "separator-header",
        "patch-today-section",
        "separator-mid",
        "patch-this-week-section"
      ]
    },
    "date": {
      "type": "Text",
      "props": {
        "text": "2026-06-25",
        "variant": "muted"
      },
      "children": []
    },
    "verdict": {
      "type": "Text",
      "props": {
        "text": "Verdict: 48 net-new npm malware drops, 1 to schedule. Sources: KEV, GH Advisory, EPSS"
      },
      "children": []
    },
    "separator-header": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      },
      "children": []
    },
    "patch-today-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "patch-today-heading",
