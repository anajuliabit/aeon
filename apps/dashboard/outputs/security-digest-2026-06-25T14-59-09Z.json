    "malware-stat": {
      "type": "Stat",
      "props": {
        "label": "Net-new npm malware advisories (last 48h)",
        "value": "48",
        "delta": "~24/day sustained"
      },
      "children": []
    },
    "malware-details": {
      "type": "Text",
      "props": {
        "text": "5 KEV adds this week: Ubiquiti UniFi trio, Lantronix EDS5000, Splunk (all deduped to prior logs, no net-new KEV today)"
      },
      "children": []
    },
    "clusters-heading": {
      "type": "Heading",
      "props": {
        "text": "Notable clusters:",
        "level": "h4"
      },
      "children": []
    },
    "cluster-hubspot": {
      "type": "Text",
      "props": {
        "text": "9× HubSpot-dev typosquats: @su-doughnym/loginui, metrics-js, react-dlb, hubspot-loginui-poc, nabisco, signup-embedder, poc-publish-test-su-doughnym, hs-locale-management, two-factor-prompt-lib"
