{
  "basePath": "..",
  "commitMessage": "vault: {{date}}",
  "autoCommitMessage": "vault: {{date}}",
  "commitDateFormat": "YYYY-MM-DD HH:mm:ss",
  "autoSaveInterval": 10,
  "autoPushInterval": 0,
  "autoPullInterval": 10,
  "autoPullOnBoot": true,
  "pullBeforePush": true,
  "differentIntervalCommitAndPush": false,
  "disablePopups": false,
  "listChangedFilesInMessageBody": false,
  "showStatusBar": true,
  "refreshSourceControl": true
}
