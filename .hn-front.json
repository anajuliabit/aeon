70,48634227,48634400,48634428,48634954,48634998,48635030,48635094,48635114,48635344,48635612,48635613,48635835,48636137,48636204,48636268,48636306,48636420,48636569,48636850,48636926,48637440,48638075,48638593,48638828,48639419,48639731,48639864,48639918,48640181],"created_at":"2026-06-19T11:06:04Z","created_at_i":1781867164,"num_comments":102,"objectID":"48597221","points":268,"story_id":48597221,"title":"My Mathematical Regression","updated_at":"2026-06-23T07:04:13Z","url":"https://blog.dahl.dev/posts/my-mathematical-regression/"},{"_highlightResult":{"author":{"matchLevel":"none","matchedWords":[],"value":"Vaslo"},"title":{"matchLevel":"none","matchedWords":[],"value":"Polymarket has flooded social media with deceptive videos by paid creators"},"url":{"matchLevel":"none","matchedWords":[],"value":"https://www.wsj.com/business/media/polymarket-social-media-bets-prediction-market-441cdeb5?st=HhTZY2"}},"_tags":["story","author_Vaslo","story_48614715","front_page"],"author":"Vaslo","children":[48616587,48617455,48619077,48638807,48638839,48638881,48638924,48639041,48639122,48639179,48639226,48639356,48639432,48639615,48639711,48639782,48640197,48640308,48640522,48640546,48640608,48640754,48640987,48641122],"created_at":"2026-06-21T01:12:21Z","created_at_i":1782004341,"num_comments":150,"objectID":"48614715","points":196,"story_id":48614715,"title":"Polymarket has flooded social media with deceptive videos by paid creators","updated_at":"2026-06-23T07:04:43Z","url":"https://www.wsj.com/business/media/polymarket-social-media-bets-prediction-market-441cdeb5?st=HhTZY2"},{"_highlightResult":{"author":{"matchLevel":"none","matchedWords":[],"value":"zdgeier"},"story_text":{"matchLevel":"none","matchedWords":[],"value":"Oak is a version control system I've been working on designed for agents (<a href=\"https://oak.space\" rel=\"nofollow\">https://oak.space</a>). It improves the speed and context your agents need when working on serious projects. With virtual mounts, agents locally and in the cloud no longer need a full copy of a repo to get working. You can work on many tasks in parallel without needing to download everything or fight worktrees. Version control shouldn't waste you or your agents time. It should be fast, creative and fun to make things with agents.<p>Oak is still early in development. There's no Windows build and missing plenty of features (no CI, no issues, no comments). We still use GitHub Actions for building Oak now, but we've been fully bootstrapped on Oak with no Git backup for several months: <a href=\"https://oak.space/oak/oak\" rel=\"nofollow\">https://oak.space/oak/oak</a>.<p>Blog post: <a href=\"https://oak.space/blog#git-is-forever\" rel=\"nofollow\">https://oak.space/blog#git-is-forever</a><p>Docs: <a href=\"https://oak.space/docs\" rel=\"nofollow\">https://oak.space/docs</a>"},"title":{"matchLevel":"none","matchedWords":[],"value":"Show HN: Oak \u2013 Git alternative designed for agents"},"url":{"matchLevel":"none","matchedWords":[],"value":"https://oak.space/oak/oak"}},"_tags":["story","author_zdgeier","story_48631726","show_hn","front_page"],"author":"zdgeier","children":[48632088,48632096,48632097,48632118,48632163,48632170,48632198,48632216,48632283,48632325,48632364,48632427,48632961,48633224,48633355,48633378,48633590,48633734,48633789,48633870,48633871,48634005,48634099,48634278,48634290,48634670,48634727,48635091,48635235,48635246,48635343,48635486,48635998,48636024,48636162,48636387,48636535,48636831,48636999,48637166,48638779,48638809,48638897,48638979,48639069,48639197,48639310,48639948,48640076,48641215,48641253],"created_at":"2026-06-22T15:37:48Z","created_at_i":1782142668,"num_comments":159,"objectID":"48631726","points":179,"story_id":48631726,"story_text":"Oak is a version control system I&#x27;ve been working on designed for agents (<a href=\"https:&#x2F;&#x2F;oak.space\" rel=\"nofollow\">https:&#x2F;&#x2F;oak.space</a>). It improves the speed and context your agents need when working on serious projects. With virtual mounts, agents locally and in the cloud no longer need a full copy of a repo to get working. You can work on many tasks in parallel without needing to download everything or fight worktrees. Version control shouldn&#x27;t waste you or your agents time. It should be fast, creative and fun to make things with agents.<p>Oak is still early in development. There&#x27;s no Windows build and missing plenty of features (no CI, no issues, no comments). We still use GitHub Actions for building Oak now, but we&#x27;ve been fully bootstrapped on Oak with no Git backup for several months: <a href=\"https:&#x2F;&#x2F;oak.space&#x2F;oak&#x2F;oak\" rel=\"nofollow\">https:&#x2F;&#x2F;oak.space&#x2F;oak&#x2F;oak</a>.<p>Blog post: <a href=\"https:&#x2F;&#x2F;oak.space&#x2F;blog#git-is-forever\" rel=\"nofollow\">https:&#x2F;&#x2F;oak.space&#x2F;blog#git-is-forever</a><p>Docs: <a href=\"https:&#x2F;&#x2F;oak.space&#x2F;docs\" rel=\"nofollow\">https:&#x2F;&#x2F;oak.space&#x2F;docs</a>","title":"Show HN: Oak \u2013 Git alternative designed for agents","updated_at":"2026-06-23T07:02:28Z","url":"https://oak.space/oak/oak"},{"_highlightResult":{"author":{"matchLevel":"none","matchedWords":[],"value":"HaxleRose"},"title":{"matchLevel":"none","matchedWords":[],"value":"Show HN: Got sick of ads, so I made my own logic puzzle site"},"url":{"matchLevel":"none","matchedWords":[],"value":"https://puzzlelair.com/"}},"_tags":["story","author_HaxleRose","story_48629213","show_hn","front_page"],"author":"HaxleRose","children":[48630363,48630369,48630471,48630475,48630592,48630625,48630650,48630661,48630853,48631007,48631019,48631137,48631168,48631174,48631265,48631574,48631728,48631994,48631996,48632042,48632122,48632234,48633645,48634512,48634985,48635201,48635215,48635245,48635322,48635804,48635920,48636546,48636550,48636690,48636847,48637465,48637968,48638667,48638709,48638936,48639346,48639456,48639526,48639725,48639976,48640089,48640650,48640832,48640857,48641222,4864