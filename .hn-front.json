tory","author_evakhoury","story_48586767","front_page"],"author":"evakhoury","children":[48640193,48640457,48640929,48641173],"created_at":"2026-06-18T15:20:31Z","created_at_i":1781796031,"num_comments":20,"objectID":"48586767","points":15,"story_id":48586767,"title":"Package Managers need global hooks","updated_at":"2026-06-23T06:55:43Z","url":"https://captnemo.in/blog/2026/06/17/package-managers-need-hooks/"},{"_highlightResult":{"author":{"matchLevel":"none","matchedWords":[],"value":"mooreds"},"title":{"matchLevel":"none","matchedWords":[],"value":"How to organize 3 acquired companies into one coherent website"},"url":{"matchLevel":"none","matchedWords":[],"value":"https://littlelanguagemodels.com/how-to-structure-your-sites-after-a-big-acquisition/"}},"_tags":["story","author_mooreds","story_47999020","front_page"],"author":"mooreds","created_at":"2026-05-03T17:07:01Z","created_at_i":1777828021,"num_comments":0,"objectID":"47999020","points":13,"story_id":47999020,"title":"How to organize 3 acquired companies into one coherent website","updated_at":"2026-05-06T09:45:55Z","url":"https://littlelanguagemodels.com/how-to-structure-your-sites-after-a-big-acquisition/"},{"_highlightResult":{"author":{"matchLevel":"none","matchedWords":[],"value":"ahlCVA"},"title":{"matchLevel":"none","matchedWords":[],"value":"Conway's Game of Life, in real life"},"url":{"matchLevel":"none","matchedWords":[],"value":"https://lcamtuf.coredump.cx/blog/conway/"}},"_tags":["story","author_ahlCVA","story_47439821","front_page"],"author":"ahlCVA","children":[47472710],"created_at":"2026-03-19T14:11:56Z","created_at_i":1773929516,"num_comments":1,"objectID":"47439821","points":12,"story_id":47439821,"title":"Conway's Game of Life, in real life","updated_at":"2026-03-23T22:52:37Z","url":"https://lcamtuf.coredump.cx/blog/conway/"},{"_highlightResult":{"author":{"matchLevel":"none","matchedWords":[],"value":"CommonGuy"},"title":{"matchLevel":"none","matchedWords":[],"value":"The new HTTP QUERY method explained"},"url":{"matchLevel":"none","matchedWords":[],"value":"https://kreya.app/blog/new-http-query-method-explained/"}},"_tags":["story","author_CommonGuy","story_48640974","front_page"],"author":"CommonGuy","children":[48641246,48641265],"created_at":"2026-06-23T06:05:37Z","created_at_i":1782194737,"num_comments":2,"objectID":"48640974","points":9,"story_id":48640974,"title":"The new HTTP QUERY method explained","updated_at":"2026-06-23T07:02:58Z","url":"https://kreya.app/blog/new-http-query-method-explained/"},{"_highlightResult":{"author":{"matchLevel":"none","matchedWords":[],"value":"dimastopel"},"story_text":{"matchLevel":"none","matchedWords":[],"value":"Back in 2012 I built <a href=\"https://cert-depot.com\" rel=\"nofollow\">https://cert-depot.com</a> as a weekend project. Node.js + Express + jQuery, shelling out to OpenSSL for certificate generation. It worked but I eventually let it rot. <a href=\"https://news.ycombinator.com/item?id=4766743\">https://news.ycombinator.com/item?id=4766743</a><p>Rewrote it from scratch in Go. The entire thing is a single binary with no external dependencies:<p>1. Certificate generation uses Go's crypto/x509 (no OpenSSL)<p>2. Certificates are generated in memory and streamed directly \u2014 nothing is stored on the server<p>3. RSA 2048/4096 and ECDSA P-256/P-384<p>4. Subject Alternative Names (required by browsers since Chrome 58)<p>5. ZIP (PEM files) or PFX/PKCS#12 output<p>You comments / suggestions / bug reports are very welcome. Thanks.<p>Source: <a href=\"https://github.com/dimastopel/certdepot\" rel=\"nofollow\">https://github.com/dimastopel/certdepot</a>"},"title":{"matchLevel":"none","matchedWords":[],"value":"Show HN: I rewrote my 2012 self-signed cert generator in Go \u2013 cert-depot.com"}},"_tags":["story","author_dimastopel","story_47613622","show_hn","front_page"],"author":"dimastopel","children":[47618945],"created_at":"2026-04-02T12:36:10Z","created_at_i":1775133370,"num_comments":1,"objectID":"47613622","points":9,"story_id":47613622,"story_text":"Back in 2012 I built <a href=\"https:&#x2F;&#x2F;cert-depot.com\" rel=\"nofollow\">https:&#x2F;&#x2F;cert-depot.com</a> as a weekend project. Node.js + Express + jQuery, shelling out to OpenSSL for certificate generation. It worked but I eventually let it rot. <a href=\"https:&#x2F;&#x2F;news.ycombinator.com&#x2F;item?id=4766743\">https:&#x2F;&#x2F;news.ycombinator.com&#x2F;item?id=4766743</a><p>Rewrote it from scratch in Go. The entire thing is a single binary with no external dependencies:<p>1. Certificate generation uses Go&#x27;s crypto&#x2F;x509 (no OpenSSL)<p>2. Certificates are generated in memory and streamed directly \u2014 nothing is stored on the server<p>3. RSA 2048&#x2F;4096 and ECDSA P-256&#x2F;P-384<p>4. Subject Alternative Names (required by browsers since Chrome 58)<p>5. ZIP (PEM files) or PFX&#x2F;PKCS#12 output<p>You comments &#x2F; suggestions &#x2F; bug reports are very welcome. Thanks.<p>Source: <a href=\"https:&#x2F;&#x2F;github.com&#x2F;dimastopel&#x2F;certdepot\" rel=\"nofollow\">https:&#x2F;&#x2F;github.com&#x2F;dimastopel&#x2F;certdepot</a>","title":"Show HN: I rewrote my 2012 self-signed cert generator in Go \u2013 cert-depot.com","updated_at":"2026-04-06T06:43:48Z"}],"hitsPerPage":30,"nbHits":129,"nbPages":5,"page":0,"params":"hitsPerPage=30&tags=front_page&advancedSyntax=true&analyticsTags=backend","processingTimeMS":47,"processingTimingsMS":{"_request":{"roundTrip":17},"extractDocsToPromoteDetails":{"initQuery":47,"total":47},"total":47},"query":"","serverTimeMS":57}
