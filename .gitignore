# macOS
.DS_Store

# Secrets & local env
.env
.env.local
.env.*.local

# Claude Code local state
.claude/

# Caches (regenerated per run)
.xai-cache/
.bankr-cache/
.pending-notify/
.pending-replicate/
.pending-supernotes/
.pending-deploy/
.pending-devto/
.pending-farcaster/
.tg_cache/
.reppo-cache/
.pending-reppo/
.vc-cache/

# Skill provenance lock (per-repo, not committed)
skills.lock

# Scratch / temp files
tmp_*
*.tmp
.tmp-*
.pending-*.sh
.run-*.sh
.*-tmp.md
.*-draft.md
.*-msg.txt
*_msg.txt
*_raw.txt

# Leaked creds scratch
.xai_key
.ghtoken

# Python bytecode
__pycache__/
*.pyc

# Node
node_modules/

# Stale artifacts
.external-work
.vuln-scan/

# Playwright MCP scratch (screenshots, snapshots, console logs)
.playwright-mcp/

# Obsidian per-machine UI state — never commit (cross-machine conflict churn).
# All other vault/.obsidian/ files are shared vault config and ARE committed.
vault/.obsidian/workspace.json
vault/.obsidian/workspace-mobile.json
vault/.obsidian/workspace.json.bak

# Obsidian community-plugin binaries — reinstall per vault; don't bloat the repo.
# We keep data.json (our shared config) but ignore the plugin code itself.
vault/.obsidian/plugins/*/main.js
vault/.obsidian/plugins/*/manifest.json
vault/.obsidian/plugins/*/styles.css
vault/.obsidian/plugins/*/*.map
vault/.obsidian/appearance.json

# Git worktrees
.worktrees/

# Investment advisor (private — never commit financials to public main)
.investiments-cache/
.pending-advisor/
reports/advisor/
.outputs/portfolio-snapshot.md
.outputs/advisor-*.md
