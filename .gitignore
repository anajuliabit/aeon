# macOS
.DS_Store

# Secrets & local env
.env
.env.local
.env.*.local

# Claude Code local state
.claude/

# Caches (regenerated per run)
.xai-cache/
.bankr-cache/
.pending-notify/
.pending-replicate/
.pending-supernotes/
.pending-deploy/
.pending-devto/
.pending-farcaster/
.tg_cache/
.reppo-cache/
.pending-reppo/
.vc-cache/

# Skill provenance lock (per-repo, not committed)
skills.lock

# Scratch / temp files
tmp_*
*.tmp
.tmp-*
.pending-*.sh
.run-*.sh
.*-tmp.md
.*-draft.md
.*-msg.txt
*_msg.txt
*_raw.txt

# Leaked creds scratch
.xai_key
.ghtoken

# Python bytecode
__pycache__/
*.pyc

# Node
node_modules/

# Stale artifacts
.external-work
.vuln-scan/

# Playwright MCP scratch (screenshots, snapshots, console logs)
.playwright-mcp/

# Obsidian per-machine UI state — never commit (cross-machine conflict churn).
# All other .obsidian/ files are shared vault config and ARE committed.
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/workspace.json.bak
